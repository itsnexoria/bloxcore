{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/blox-fruits-values/kitsune/index.html",
        "http://localhost/blox-fruits-tier-list/index.html",
        "http://localhost/blox-fruits-compare/kitsune-vs-dough/index.html",
        "http://localhost/blox-fruits-best-fruit-first-sea/index.html",
        "http://localhost/blox-fruits-fruits/index.html",
        "http://localhost/discord/index.html",
        "http://localhost/trading/index.html",
        "http://localhost/giveaways/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --disable-gpu" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
