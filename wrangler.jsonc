{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloxcore",
  "compatibility_date": "2026-09-18",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/player/*", "/auth/*", "/crew/*", "/trading/*", "/og/*", "/trade-calculator*", "/blox-fruits-value-changes*", "/scam-check*", "/blox-fruits-updates*", "/tier-maker*", "/build-planner*"]
  },
  "observability": {
    "enabled": true
  }
}
